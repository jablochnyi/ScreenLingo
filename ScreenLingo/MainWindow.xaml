<Window x:Class="ScreenLingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLingo" Height="520" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF181818" Foreground="White">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">

            <TextBlock Text="ScreenLingo"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#FF4FC3F7"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="SelectRegionButton"
                        Content="Захват экрана"
                        Width="150" Height="36" Margin="8,0"
                        Background="#FF2196F3" Foreground="White"
                        BorderThickness="0" Click="StartCapture"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="65,8,0,8">
                <Button x:Name="SetHotkeyButton" Content="Назначить горячую клавишу" Width="220" Height="32" Background="#FF424242" Foreground="White" BorderThickness="0" Click="AssignHotkey_Click"/>
                <TextBox x:Name="HotkeyBox" Width="160" Margin="8,0,0,0" IsReadOnly="True" Text="(не выбрано)" Background="#FF2E2E2E" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
            
            <!-- Добавь рядом с существующими контролами -->
            <StackPanel Orientation="Horizontal" Margin="65,8,0,8">
                <Button Content="Назначить хоткей показа/скрытия" Width="220" Height="32" Background="#FF424242" Foreground="White" Click="AssignToggleHotkey_Click"/>
                <TextBox x:Name="ToggleHotkeyBox" Width="160" Margin="8,0,0,0" IsReadOnly="True" Text="(не выбрано)" Background="#FF2E2E2E" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>


            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Распознаваемый язык:" FontSize="14" Margin="30,0,0,4"/>
                    <ComboBox x:Name="SourceLangComboBox" Width="200" Height="30"
                              Background="#FF2E2E2E" BorderThickness="0" Foreground="Black">
                        <ComboBoxItem Content="English" Tag="eng"/>
                        <ComboBoxItem Content="Japanese" Tag="jpn"/>
                        <ComboBoxItem Content="Korean" Tag="kor"/>
                        <ComboBoxItem Content="Chinese" Tag="chi_sim"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Переводчик:" FontSize="14" Margin="30,0,0,4"/>
                    <ComboBox x:Name="TranslatorComboBox" Width="200" Height="30"
                              Background="#FF2E2E2E" BorderThickness="0" Foreground="Black">
                        <ComboBoxItem Content="Google" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="Размер шрифта:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FontSizeBox" Width="60" Height="20" Text="20"
                         TextAlignment="Center" PreviewTextInput="FontSize_PreviewTextInput"
                         Background="#FF2E2E2E" BorderThickness="0" Foreground="White"/>
            </StackPanel>

            <TextBlock Text="После выбора области нажмите назначенную горячую клавишу, чтобы обновить перевод."
                       FontSize="13" Foreground="#FFBDBDBD" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Width="480"/>

        </StackPanel>
    </Grid>
</Window>
